# Vercel KV (Redis)
KV_REST_API_URL=your_vercel_kv_url
KV_REST_API_TOKEN=your_vercel_kv_token
KV_REST_API_READ_ONLY_TOKEN=your_vercel_kv_read_token

# Vercel Blob
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Admin credentials
ADMIN_USERNAME=admin
